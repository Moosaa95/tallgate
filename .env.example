# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
# Canonical origin of the deployed site. Used for certificate verification links
# and metadata. Must be a real https origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL and browser-safe anon key. Public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key with full database access. Required by the Admin UI for user
# and role management. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------
# Optional. Both are only read by POST /api/email. Without RESEND_API_KEY the
# route returns 503 and does not send mail; without RESEND_FROM_EMAIL it
# returns 503 as well, because there is no safe default sender address.
RESEND_API_KEY=
# Verified sender, in Resend "Name <address>" form. No default is assumed.
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Build-time checks
# -----------------------------------------------------------------------------
# next.config.mjs logs a warning during `next build` when RESEND_API_KEY,
# NEXT_PUBLIC_SITE_URL (or a localhost value), or SUPABASE_SERVICE_ROLE_KEY is
# missing. Warnings only; they do not fail the build.
