# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
# Canonical origin of the deployed site. Used for certificate verification links
# and metadata. Must be a real https origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL and browser-safe anon key. Public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key with full database access. Required by the Admin UI for user
# and role management. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------
# Optional. Without these, /api/email logs a warning and does not send mail.
RESEND_API_KEY=
# Verified sender. Defaults to TallGate <noreply@tallgate.com> when unset.
RESEND_FROM_EMAIL=
